# Ghostty terminal configuration.

font-family = "MesloLGS NF"
font-size = 13

# Let the left Option key send Alt, so readline word-motions and fzf's Alt-C
# binding work.
macos-option-as-alt = left

# Keep Ghostty's native TERM (xterm-ghostty) locally for the richest experience,
# but fall back to xterm-256color inside ssh sessions, since remote hosts won't
# have the ghostty terminfo entry.
shell-integration-features = ssh-env
